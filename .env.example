# Public browser configuration for isolated local Firebase emulators.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-poorinter.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-poorinter
VITE_FIREBASE_STORAGE_BUCKET=demo-poorinter.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# Optional: defaults to the local app endpoint for VITE_FIREBASE_PROJECT_ID.
# VITE_FUNCTIONS_URL=http://127.0.0.1:5001/demo-poorinter/us-central1/app
