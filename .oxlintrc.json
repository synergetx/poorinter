{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "ignorePatterns": [
    "build/**",
    "functions/lib/**",
    "functions/vendor/**",
    "node_modules/**",
    "**/node_modules/**"
  ]
}
