{
  "name": "poorinter-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "lint": "oxlint src tests scripts",
    "lint:fix": "oxlint --fix src tests scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean.mjs && tsc && node scripts/copy-fonts.mjs",
    "test": "yarn build && node --test tests/*.test.mjs",
    "check": "yarn lint && yarn format:check && yarn typecheck && yarn test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "helmet": "8.3.0",
    "opentype.js": "2.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "22"
  },
  "packageManager": "yarn@4.18.1"
}
